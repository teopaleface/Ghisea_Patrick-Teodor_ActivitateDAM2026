<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F6F5F0">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LABORATOR 2–3 · ACTIVITATEA 3" android:textSize="12sp" android:textColor="#1C6B59" android:layout_marginBottom="12dp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Datele au ajuns" android:textSize="30sp" android:textColor="#263A34" android:layout_marginBottom="12dp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Informațiile primite sunt afișate și într-un Toast." android:textSize="16sp" android:textColor="#263A34" android:layout_marginBottom="12dp"/>
        <TextView android:id="@+id/received" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Date primite" android:textSize="18sp" android:textColor="#263A34" android:padding="16dp" android:background="@drawable/card" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
        <TextView android:id="@+id/sum" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sumă" android:textSize="18sp" android:textColor="#263A34" android:padding="16dp" android:background="@drawable/card" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/return_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:textAllCaps="false" android:text="Trimite rezultatul înapoi" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:textAllCaps="false" android:text="Anulează" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
